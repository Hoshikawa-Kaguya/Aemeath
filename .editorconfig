root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 前端与配置文件沿用社区惯例的 2 空格缩进（与 Prettier 一致）
[*.{ts,mts,js,mjs,vue,json,css,html,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
